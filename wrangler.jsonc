// Cloudflare Workers 設定：GitHub push 到 main 後由 Workers Builds 自動部署。
// public/ 是網站本身；/api/* 先經 worker/index.js 驗證登入，再代轉到 Apps Script。
// 機密不放這裡，在 Cloudflare 後台 Worker → Settings → Variables and Secrets 以「Secret」新增：
//   APPS_SCRIPT_URL  Apps Script 網頁應用程式網址（…/exec）
//   API_TOKEN        與 code.gs 的 TOKEN 相同
{
  "name": "catpatrol",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // 預覽網址不在 Access 保護範圍內，關掉
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Cloudflare Access 的團隊網域與應用程式 AUD（公開資訊，用來驗證登入憑證）。
    // 改了 Zero Trust 團隊名稱或重建 Access 應用程式後兩者都會變：未登入時打開網站，
    // 被導去的登入網址主機名稱＝團隊網域，網址參數 kid＝AUD。
    "ACCESS_TEAM_DOMAIN": "https://wildervalley.cloudflareaccess.com",
    "ACCESS_AUD": "839bdee597c883e37f7a3f4eae641a1dde0d5cb232bf2d7396cd5a1b1f2b587c"
  }
}
